@model LuminKazan.Models.PortfolioItem

@{
    ViewData["Title"] = "Удаление работы";
}

<section class="admin-page">
    <div class="admin-header">
        <span class="section-label">Портфолио</span>
        <h1>Удаление работы</h1>
        <p>Проверьте данные и подтвердите удаление работы из портфолио.</p>
    </div>

    <div class="booking-form-wrapper">
        <p><strong>Название:</strong> @Model.Title</p>
        <p><strong>Категория:</strong> @Model.Category?.Name</p>
        <p><strong>Фотограф:</strong> @Model.Photographer?.FullName</p>
        <p><strong>Студия:</strong> @(Model.Studio?.Name ?? "Без студии")</p>
        <p><strong>Дата:</strong> @(Model.ShootingDate.HasValue ? Model.ShootingDate.Value.ToString("dd.MM.yyyy") : "Не указана")</p>
        <p><strong>Избранная:</strong> @(Model.IsFeatured ? "Да" : "Нет")</p>
        <p><strong>Путь к изображению:</strong> @Model.ImagePath</p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p><strong>Описание:</strong> @Model.Description</p>
        }

        <form asp-controller="Admin" asp-action="DeletePortfolioItem" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="admin-links">
                <button type="submit" class="btn btn-danger">Удалить работу</button>
                <a asp-controller="Admin" asp-action="PortfolioItems" class="btn btn-outline-secondary">Отмена</a>
            </div>
        </form>
    </div>
</section>