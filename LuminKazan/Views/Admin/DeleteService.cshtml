@model LuminKazan.Models.Service

@{
    ViewData["Title"] = "Удаление услуги";
}

<section class="admin-page">
    <div class="admin-header">
        <span class="section-label">Услуги</span>
        <h1>Удаление услуги</h1>
        <p>Проверьте данные и подтвердите удаление услуги.</p>
    </div>

    <div class="booking-form-wrapper">
        <p><strong>Название:</strong> @Model.Title</p>
        <p><strong>Описание:</strong> @Model.Description</p>
        <p><strong>Длительность:</strong> @Model.DurationMinutes мин.</p>
        <p><strong>Цена:</strong> @Model.Price.ToString("N0") ₽</p>
        <p><strong>Фото в ретуши:</strong> @Model.RetouchedPhotosCount</p>
        <p><strong>Все фото:</strong> @Model.AllPhotosCount</p>
        <p><strong>Срок готовности:</strong> @Model.DeliveryDays дн.</p>
        <p><strong>Студия включена:</strong> @(Model.IncludesStudio ? "Да" : "Нет")</p>
        <p><strong>Активна:</strong> @(Model.IsActive ? "Да" : "Нет")</p>

        <form asp-controller="Admin" asp-action="DeleteService" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="admin-links">
                <button type="submit" class="btn btn-danger">Удалить услугу</button>
                <a asp-controller="Admin" asp-action="Services" class="btn btn-outline-secondary">Отмена</a>
            </div>
        </form>
    </div>
</section>