@{
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var isAdmin = User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LuminKazan</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/studios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container header-container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    LuminKazan
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Главная
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Portfolio" asp-action="Index">
                                Портфолио
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="services">
                                Услуги
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Studios" asp-action="Index">
                                Студии
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Create">
                                Запись
                            </a>
                        </li>

                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    Вход
                                </a>
                            </li>
                        }
                        else
                        {
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        Админка
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                    @Html.AntiForgeryToken()<button type="submit" class="nav-link logout-button">
                                        Выход
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <h3>LuminKazan</h3>

            <p>Фотосъемки, портфолио и подборка студий для съемок в Казани.</p>

            <div class="footer-links">
                <a asp-controller="Portfolio" asp-action="Index">Портфолио</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="services">Услуги</a>
                <a asp-controller="Studios" asp-action="Index">Студии</a>
                <a asp-controller="Booking" asp-action="Create">Запись</a>
            </div>

            <p class="copyright">© 2026 LuminKazan. Все права защищены.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>